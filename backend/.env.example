# Copy this file to .env  (PowerShell:  Copy-Item .env.example .env)
PORT=5000

# MongoDB Atlas example (replace ALL three placeholders):
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/medical_diagnosis?retryWrites=true&w=majority
# Local MongoDB instead:
# MONGODB_URI=mongodb://127.0.0.1:27017/medical_diagnosis

# Long random secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Frontend URL(s), comma separated. Any localhost port is also allowed during development.
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5
